{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Three layers: primitive (fixed) -> semantic (themed) -> component (references semantic only). Semantic color tokens carry a light and a dark value, emitted as CSS light-dark(). Accent is an indirection: {accent.N} resolves against whichever ramp [data-accent] selects.",

  "primitive": {
    "color": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#0A0A09", "$type": "color" },
      "ink": {
        "50":  { "$value": "#FAFAF9", "$type": "color" },
        "100": { "$value": "#F2F1EE", "$type": "color" },
        "200": { "$value": "#E4E2DD", "$type": "color" },
        "300": { "$value": "#CFCCC3", "$type": "color" },
        "400": { "$value": "#A6A296", "$type": "color" },
        "500": { "$value": "#7C7768", "$type": "color" },
        "600": { "$value": "#59564A", "$type": "color" },
        "700": { "$value": "#403D35", "$type": "color" },
        "800": { "$value": "#282622", "$type": "color" },
        "900": { "$value": "#17160F", "$type": "color" },
        "950": { "$value": "#0A0A09", "$type": "color" }
      },
      "red": {
        "500": { "$value": "#E5484D", "$type": "color" },
        "600": { "$value": "#CC3A3F", "$type": "color" }
      }
    },
    "spacing": {
      "0":  { "$value": "0", "$type": "dimension" },
      "px": { "$value": "1px", "$type": "dimension" },
      "1":  { "$value": "0.25rem", "$type": "dimension" },
      "2":  { "$value": "0.5rem", "$type": "dimension" },
      "3":  { "$value": "0.75rem", "$type": "dimension" },
      "4":  { "$value": "1rem", "$type": "dimension" },
      "5":  { "$value": "1.25rem", "$type": "dimension" },
      "6":  { "$value": "1.5rem", "$type": "dimension" },
      "8":  { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" },
      "20": { "$value": "5rem", "$type": "dimension" },
      "24": { "$value": "6rem", "$type": "dimension" }
    },
    "fontFamily": {
      "mono":     { "$value": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace", "$type": "fontFamily" },
      "flourish": { "$value": "'Fraunces', 'Times New Roman', serif", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs":  { "$value": "0.75rem", "$type": "dimension" },
      "sm":  { "$value": "0.875rem", "$type": "dimension" },
      "base":{ "$value": "1rem", "$type": "dimension" },
      "lg":  { "$value": "1.125rem", "$type": "dimension" },
      "xl":  { "$value": "1.375rem", "$type": "dimension" },
      "2xl": { "$value": "1.75rem", "$type": "dimension" },
      "3xl": { "$value": "2.25rem", "$type": "dimension" },
      "4xl": { "$value": "3rem", "$type": "dimension" },
      "5xl": { "$value": "4rem", "$type": "dimension" },
      "6xl": { "$value": "5.5rem", "$type": "dimension" }
    },
    "fontWeight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "medium":   { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    },
    "tracking": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0", "$type": "dimension" },
      "wide":   { "$value": "0.04em", "$type": "dimension" },
      "wider":  { "$value": "0.12em", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm":   { "$value": "0.25rem", "$type": "dimension" },
      "md":   { "$value": "0.5rem", "$type": "dimension" },
      "lg":   { "$value": "0.875rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "duration": {
      "instant": { "$value": "80ms", "$type": "duration" },
      "fast":    { "$value": "150ms", "$type": "duration" },
      "normal":  { "$value": "220ms", "$type": "duration" },
      "slow":    { "$value": "420ms", "$type": "duration" },
      "ambient": { "$value": "6000ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "out":      { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" },
      "spring":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" },
      "linear":   { "$value": "linear", "$type": "cubicBezier" }
    }
  },

  "accent": {
    "$description": "Selected by [data-accent] on the root. 'green' is the default. Every 600 clears 4.5:1 on white; every 400 clears 4.5:1 on ink-950.",
    "green":  { "50": "#F0FBF4", "100": "#DBF5E4", "200": "#B8EACB", "300": "#86D9A8", "400": "#4FC17F", "500": "#2AA35F", "600": "#1C8049", "700": "#166238", "800": "#134D2E", "900": "#113F27", "950": "#06210F" },
    "amber":  { "50": "#FDF8ED", "100": "#F9EDD0", "200": "#F2DAA1", "300": "#E7C065", "400": "#D9A22F", "500": "#BF8718", "600": "#9A6A11", "700": "#7A530F", "800": "#63430F", "900": "#52380F", "950": "#2E1E06" },
    "indigo": { "50": "#F1F3FD", "100": "#E1E5FB", "200": "#C7CEF7", "300": "#A2ADF0", "400": "#7B87E6", "500": "#5B63D8", "600": "#4746C4", "700": "#3A38A0", "800": "#313081", "900": "#2C2C68", "950": "#1B1A3D" },
    "clay":   { "50": "#FDF2F3", "100": "#FBE3E5", "200": "#F7CBD0", "300": "#F0A5AD", "400": "#E47483", "500": "#D44C5E", "600": "#B93348", "700": "#9B283C", "800": "#822438", "900": "#6F2234", "950": "#3E0E19" }
  },

  "semantic": {
    "color": {
      "$description": "Each token carries light and dark. Emitted as light-dark(light, dark).",
      "surface":           { "$type": "color", "light": "{primitive.color.white}",     "dark": "{primitive.color.ink.950}" },
      "surface-sunken":    { "$type": "color", "light": "{primitive.color.ink.50}",    "dark": "{primitive.color.ink.900}" },
      "ink":               { "$type": "color", "light": "{primitive.color.ink.950}",   "dark": "{primitive.color.ink.50}" },
      "ink-muted":         { "$type": "color", "light": "{primitive.color.ink.600}",   "dark": "{primitive.color.ink.400}", "$description": "ink.600 not ink.500 — ink.500 on white is 4.47:1 and misses AA." },
      "ink-faint":         { "$type": "color", "light": "{primitive.color.ink.300}",   "dark": "{primitive.color.ink.600}" },
      "border":            { "$type": "color", "light": "{primitive.color.ink.200}",   "dark": "{primitive.color.ink.800}" },
      "border-strong":     { "$type": "color", "light": "{primitive.color.ink.950}",   "dark": "{primitive.color.ink.50}" },

      "accent":            { "$type": "color", "light": "{accent.600}", "dark": "{accent.400}" },
      "accent-hover":      { "$type": "color", "light": "{accent.700}", "dark": "{accent.300}" },
      "accent-active":     { "$type": "color", "light": "{accent.800}", "dark": "{accent.200}" },
      "accent-soft":       { "$type": "color", "light": "{accent.50}",  "dark": "{accent.950}" },
      "accent-soft-hover": { "$type": "color", "light": "{accent.100}", "dark": "{accent.900}" },
      "accent-foreground": { "$type": "color", "light": "{primitive.color.white}", "dark": "{primitive.color.ink.950}" },

      "focus-ring":        { "$type": "color", "light": "{accent.500}", "dark": "{accent.400}" },
      "danger":            { "$type": "color", "light": "{primitive.color.red.600}", "dark": "{primitive.color.red.500}" }
    },

    "spacing": {
      "$description": "Selected by [data-density]. 'default' is the base scale.",
      "gutter":    { "$type": "dimension", "compact": "{primitive.spacing.4}",  "default": "{primitive.spacing.6}",  "comfortable": "{primitive.spacing.8}" },
      "gutter-lg": { "$type": "dimension", "compact": "{primitive.spacing.8}",  "default": "{primitive.spacing.12}", "comfortable": "{primitive.spacing.16}" },
      "stack-xs":  { "$type": "dimension", "compact": "{primitive.spacing.1}",  "default": "{primitive.spacing.2}",  "comfortable": "{primitive.spacing.3}" },
      "stack-sm":  { "$type": "dimension", "compact": "{primitive.spacing.3}",  "default": "{primitive.spacing.4}",  "comfortable": "{primitive.spacing.5}" },
      "stack":     { "$type": "dimension", "compact": "{primitive.spacing.4}",  "default": "{primitive.spacing.6}",  "comfortable": "{primitive.spacing.8}" },
      "stack-lg":  { "$type": "dimension", "compact": "{primitive.spacing.6}",  "default": "{primitive.spacing.10}", "comfortable": "{primitive.spacing.12}" }
    },

    "typography": {
      "display": { "$value": "{primitive.fontSize.6xl}", "$type": "dimension" },
      "heading": { "$value": "{primitive.fontSize.3xl}", "$type": "dimension" },
      "tagline": { "$value": "{primitive.fontSize.lg}", "$type": "dimension" },
      "body":    { "$value": "{primitive.fontSize.base}", "$type": "dimension" },
      "label":   { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "caption": { "$value": "{primitive.fontSize.xs}", "$type": "dimension" }
    },

    "motion": {
      "hover":        { "$value": "{primitive.duration.fast}", "$type": "duration" },
      "press":        { "$value": "{primitive.duration.instant}", "$type": "duration" },
      "enter":        { "$value": "{primitive.duration.normal}", "$type": "duration" },
      "playful":      { "$value": "{primitive.duration.slow}", "$type": "duration" },
      "ease-default": { "$value": "{primitive.easing.out}", "$type": "cubicBezier" },
      "ease-playful": { "$value": "{primitive.easing.spring}", "$type": "cubicBezier" }
    },

    "shadow": {
      "$description": "Derived from live semantic colors via color-mix, so shadows follow theme and accent with no per-mode redefinition.",
      "none":         { "$value": "none", "$type": "shadow" },
      "hairline":     { "$value": "0 0 0 1px color-mix(in srgb, {semantic.color.border-strong} 8%, transparent)", "$type": "shadow" },
      "lift":         { "$value": "0 8px 24px -12px color-mix(in srgb, {semantic.color.border-strong} 20%, transparent)", "$type": "shadow" },
      "glow-accent":  { "$value": "0 0 0 1px color-mix(in srgb, {semantic.color.accent} 40%, transparent), 0 8px 28px -8px color-mix(in srgb, {semantic.color.accent} 45%, transparent)", "$type": "shadow" }
    }
  },

  "component": {
    "$description": "References semantic tokens only — never a raw hex — so every component inherits theme, accent, and density for free.",
    "gateway-card": {
      "bg":           { "$value": "{semantic.color.surface}", "$type": "color" },
      "border":       { "$value": "{semantic.color.border}", "$type": "color" },
      "border-hover": { "$value": "{semantic.color.accent}", "$type": "color" },
      "shadow":       { "$value": "{semantic.shadow.hairline}", "$type": "shadow" },
      "shadow-hover": { "$value": "{semantic.shadow.glow-accent}", "$type": "shadow" },
      "radius":       { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding":      { "$value": "{semantic.spacing.gutter}", "$type": "dimension" },
      "lift-hover":   { "$value": "-4px", "$type": "dimension" }
    },
    "social-icon": {
      "size":         { "$value": "2.75rem", "$type": "dimension" },
      "bg":           { "$value": "{semantic.color.surface}", "$type": "color" },
      "bg-hover":     { "$value": "{semantic.color.accent-soft}", "$type": "color" },
      "border":       { "$value": "{semantic.color.border}", "$type": "color" },
      "border-hover": { "$value": "{semantic.color.accent}", "$type": "color" },
      "fg":           { "$value": "{semantic.color.ink}", "$type": "color" },
      "fg-hover":     { "$value": "{semantic.color.accent-active}", "$type": "color" },
      "radius":       { "$value": "{primitive.radius.full}", "$type": "dimension" }
    },
    "focus-ring": {
      "color":  { "$value": "{semantic.color.focus-ring}", "$type": "color" },
      "width":  { "$value": "2px", "$type": "dimension" },
      "offset": { "$value": "3px", "$type": "dimension" }
    },
    "chip": {
      "bg":        { "$value": "{semantic.color.ink}", "$type": "color" },
      "fg":        { "$value": "{semantic.color.surface}", "$type": "color" },
      "radius":    { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.1}", "$type": "dimension" }
    }
  }
}
